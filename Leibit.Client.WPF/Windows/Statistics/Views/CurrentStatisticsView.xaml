<controls:LeibitWindow x:Class="Leibit.Client.WPF.Windows.Statistics.Views.CurrentStatisticsView"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:controls="clr-namespace:Leibit.Controls;assembly=Leibit.Controls.WPF"
                       xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
                       xmlns:local="clr-namespace:Leibit.Client.WPF.Windows.Statistics.Views"
                       xmlns:vm="clr-namespace:Leibit.Client.WPF.Windows.Statistics.ViewModels"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       mc:Ignorable="d"
                       Caption="Aktuelle Statistik"
                       ResizeMode="ResizeAll"
                       d:DataContext="{d:DesignInstance vm:CurrentStatisticsViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,0">
            <TextBlock Text="ESTW" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding ESTWList}" SelectedItem="{Binding SelectedESTW}" DisplayMemberPath="Name" MinWidth="100"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">
                <GroupBox Header="Züge im Stellbereich" Margin="5">
                    <local:TrainTypeStatisticsView DataContext="{Binding Total}" Margin="10"/>
                </GroupBox>

                <GroupBox Header="Reisezüge" Margin="5">
                    <local:TrainTypeStatisticsView DataContext="{Binding PassengerTrains}" Margin="10"/>
                </GroupBox>

                <GroupBox Header="Güterzüge" Margin="5">
                    <local:TrainTypeStatisticsView DataContext="{Binding FreightTrains}" Margin="10"/>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</controls:LeibitWindow>
