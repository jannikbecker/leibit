<controls:LeibitWindow x:Class="Leibit.Client.WPF.Windows.Statistics.Views.HistoricalStatisticsView"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                       xmlns:local="clr-namespace:Leibit.Client.WPF.Windows.Statistics.Views"
                       xmlns:vm="clr-namespace:Leibit.Client.WPF.Windows.Statistics.ViewModels"
                       xmlns:controls="clr-namespace:Leibit.Controls;assembly=Leibit.Controls.WPF"
                       xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
                       mc:Ignorable="d"
                       Caption="Schicht-Bilanz"
                       d:DataContext="{d:DesignInstance vm:HistoricalStatisticsViewModel}">

    <controls:LeibitWindow.Resources>
        <local:DelayConverter x:Key="DelayConverter"/>
    </controls:LeibitWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,0">
            <TextBlock Text="ESTW" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding ESTWList}" SelectedItem="{Binding SelectedESTW, Mode=TwoWay}" DisplayMemberPath="Name" MinWidth="100" Margin="0,0,50,0" />

            <TextBlock Text="Filter" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding StatisticTypes}" SelectedItem="{Binding SelectedStatisticType, Mode=TwoWay}" DisplayMemberPath="Name"/>
        </StackPanel>

        <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource TextForeground}" Margin="5,10"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Anzahl Züge" Padding="10" Margin="5">
                        <TextBlock Text="{Binding HistoricalStatistics.NumberOfTrains}" FontSize="24"/>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="Pünktlichkeit" Padding="10" Margin="5">
                        <local:DelayStatisticsView DataContext="{Binding DelayStatistics}"/>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="Verspätung abgebaut" Padding="10" Margin="5">
                        <TextBlock Text="{Binding HistoricalStatistics.DelayReduced, Converter={StaticResource DelayConverter}}" FontSize="24"/>
                    </GroupBox>

                    <GroupBox Grid.Column="3" Header="Verspätung aufgebaut" Padding="10" Margin="5">
                        <TextBlock Text="{Binding HistoricalStatistics.DelayAdded, Converter={StaticResource DelayConverter}}" FontSize="24"/>
                    </GroupBox>

                    <GroupBox Grid.Column="4" Header="Verspätungsbilanz" Padding="10" Margin="5">
                        <TextBlock Text="{Binding HistoricalStatistics.DelayTotalNet, Converter={StaticResource DelayConverter}}" FontSize="24"/>
                    </GroupBox>
                </Grid>

                <GroupBox Grid.Row="1" Header="Zeitlicher Verlauf" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                            <CheckBox Content="Anzahl Züge" IsChecked="{Binding ShowNumbersOfTrains, Mode=TwoWay}" Margin="0,0,20,0" VerticalAlignment="Center" />
                            <CheckBox Content="Gesamtverspätung" IsChecked="{Binding ShowDelays, Mode=TwoWay}" Margin="0,0,20,0" VerticalAlignment="Center" />
                            <CheckBox Content="Pünktlichkeit" IsChecked="{Binding ShowOnTimeRates, Mode=TwoWay}" Margin="0,0,20,0" VerticalAlignment="Center" />

                            <TextBlock Text="Skalierung" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <ComboBox SelectedValue="{Binding FrameSize, Mode=TwoWay}" SelectedValuePath="Content">
                                <ComboBoxItem>5</ComboBoxItem>
                                <ComboBoxItem>10</ComboBoxItem>
                                <ComboBoxItem>15</ComboBoxItem>
                                <ComboBoxItem>20</ComboBoxItem>
                                <ComboBoxItem>30</ComboBoxItem>
                                <ComboBoxItem>60</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                        
                        <lvc:CartesianChart Grid.Row="1" Background="{DynamicResource WindowBackground}" Height="300">
                            <lvc:CartesianChart.XAxes>
                                <lvc:AxesCollection>
                                    <lvc:XamlAxis Labels="{Binding Frames}"/>
                                </lvc:AxesCollection>
                            </lvc:CartesianChart.XAxes>

                            <lvc:CartesianChart.YAxes>
                                <lvc:AxesCollection>
                                    <lvc:XamlAxis AxisName="Anzahl Züge"
                                                  ShowSeparatorLines="False"
                                                  MinLimit="0"
                                                  NamePaint="{Binding NumberOfTrainsStroke}"
                                                  LabelsPaint="{Binding NumberOfTrainsStroke}"
                                                  IsVisible="{Binding ShowNumbersOfTrains}" />
                                    <lvc:XamlAxis AxisName="Gesamtverspätung [min]"
                                                  ShowSeparatorLines="False"
                                                  MinLimit="0"
                                                  Position="End"
                                                  NamePaint="{Binding DelaysStroke}"
                                                  LabelsPaint="{Binding DelaysStroke}"
                                                  IsVisible="{Binding ShowDelays}" />
                                    <lvc:XamlAxis AxisName="Pünktlichkeit [%]"
                                                  MinLimit="0"
                                                  MaxLimit="100"
                                                  ShowSeparatorLines="False"
                                                  Position="End"
                                                  NamePaint="{Binding OnTimeRatesStroke}"
                                                  LabelsPaint="{Binding OnTimeRatesStroke}"
                                                  IsVisible="{Binding ShowOnTimeRates}" />
                                </lvc:AxesCollection>
                            </lvc:CartesianChart.YAxes>

                            <lvc:CartesianChart.Series>
                                <lvc:SeriesCollection>
                                    <lvc:XamlLineSeries SeriesName="Anzahl Züge"
                                                        Values="{Binding NumbersOfTrains}"
                                                        GeometrySize="0"
                                                        ScalesYAt="0"
                                                        LineSmoothness="0"
                                                        Fill="{x:Null}"
                                                        Stroke="{Binding NumberOfTrainsStroke}"
                                                        IsVisible="{Binding ShowNumbersOfTrains}"
                                                        XToolTipLabelFormatter="{Binding ToolTipFormatterFunc}"/>
                                    <lvc:XamlLineSeries SeriesName="Gesamtverspätung"
                                                        Values="{Binding Delays}"
                                                        GeometrySize="0"
                                                        ScalesYAt="1"
                                                        LineSmoothness="0"
                                                        Fill="{x:Null}"
                                                        Stroke="{Binding DelaysStroke}"
                                                        IsVisible="{Binding ShowDelays}"
                                                        XToolTipLabelFormatter="{Binding ToolTipFormatterFunc}"
                                                        YToolTipLabelFormatter="{Binding ToolTipFormatterDelay}"/>
                                    <lvc:XamlLineSeries SeriesName="Pünktlichkeit"
                                                        Values="{Binding OnTimeRates}"
                                                        GeometrySize="0"
                                                        ScalesYAt="2"
                                                        LineSmoothness="0"
                                                        Fill="{x:Null}"
                                                        Stroke="{Binding OnTimeRatesStroke}"
                                                        IsVisible="{Binding ShowOnTimeRates}"
                                                        XToolTipLabelFormatter="{Binding ToolTipFormatterFunc}"
                                                        YToolTipLabelFormatter="{Binding ToolTipFormatterOnTimeRate}"/>
                                </lvc:SeriesCollection>
                            </lvc:CartesianChart.Series>
                        </lvc:CartesianChart>
                    </Grid>
                </GroupBox>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Züge mit größter Verspätung" Margin="5">
                        <controls:LeibitDataGrid ItemsSource="{Binding TrainsWithGreatestDelays}"
                                                 SelectedItem="{Binding SelectedTrain, Mode=TwoWay}"
                                                 CanGroup="False"
                                                 RowDoubleClickCommand="{Binding ShowTrainScheduleCommand}">
                            <controls:LeibitDataGrid.Columns>
                                <controls:LeibitDataGridColumn Header="Gattung" FieldName="TrainType" />
                                <controls:LeibitDataGridColumn Header="ZN" FieldName="TrainNumber"/>
                                <controls:LeibitDataGridColumn Header="Vsp" FieldName="DelayString"/>
                                <controls:LeibitDataGridColumn Header="Grund" FieldName="Reasons"/>
                            </controls:LeibitDataGrid.Columns>
                        </controls:LeibitDataGrid>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="Betriebsstellen mit größter Verspätung" Margin="5">
                        <controls:LeibitDataGrid ItemsSource="{Binding StationsWithGreatestDelays}"
                                                 CanGroup="False">
                            <controls:LeibitDataGrid.Columns>
                                <controls:LeibitDataGridColumn Header="Kürzel" FieldName="StationShort" />
                                <controls:LeibitDataGridColumn Header="Name" FieldName="StationName"/>
                                <controls:LeibitDataGridColumn Header="Vsp" FieldName="DelayString"/>
                            </controls:LeibitDataGrid.Columns>
                        </controls:LeibitDataGrid>
                    </GroupBox>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</controls:LeibitWindow>
